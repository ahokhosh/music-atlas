{
  "name": "music-atlas",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite --port=5173 --host=0.0.0.0",
    "dev:all": "start /b npx tsx server.ts & npx vite --port=5173 --host=0.0.0.0",
    "start": "node server.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node18 --outfile=server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "compression": "^1.8.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "mysql2": "^3.23.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "hls.js": "1.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^8.2.1"
  }
}

